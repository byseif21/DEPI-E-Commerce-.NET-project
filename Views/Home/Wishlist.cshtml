@model List<Styleza.Models.Wishlist>

@{
    ViewData["Title"] = "My Wishlist";
}

@section Styles {
    <link rel="stylesheet" href="~/css/wishlist.css" />
}

<div class="wishlist-page">
    <div class="container">
        <div class="wishlist-header">
            <h1>My Wishlist</h1>
            <p>Keep track of the items you love across our collection</p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-wishlist">
                <i class="far fa-heart"></i>
                <h2>Your Wishlist is Empty</h2>
                <p>Seems like you haven't added anything to your wishlist yet. Explore our shop and find something you'll love!</p>
                <div class="empty-wishlist-actions">
                    <a asp-controller="Products" asp-action="Shop" class="btn-continue-shopping">Continue Shopping</a>
                </div>
            </div>
        }
        else
        {
            <div class="wishlist-grid">
                @foreach (var item in Model)
                {
                    @await Html.PartialAsync("_ProductCard", item.Product, new ViewDataDictionary(ViewData) { { "IsWishlist", true }, { "WishlistId", item.Id } })
                }
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle remove from wishlist
            document.querySelectorAll('.remove-from-wishlist').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    const id = this.dataset.id;
                    const productCard = this.closest('.product-card');
                    
                    try {
                        const response = await fetch(`/Home/RemoveFromWishlist?wishlistItemId=${id}`, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });
                        
                        if (response.ok) {
                            productCard.style.opacity = '0';
                            productCard.style.transform = 'scale(0.8)';
                            
                            setTimeout(() => {
                                productCard.remove();
                                
                                // Check if there are any items left
                                if (document.querySelectorAll('.product-card').length === 0) {
                                    const container = document.querySelector('.wishlist-page .container');
                                    container.innerHTML = `
                                        <div class="wishlist-header">
                                            <h1>My Wishlist</h1>
                                            <p>Keep track of the items you love across our collection</p>
                                        </div>
                                        <div class="empty-wishlist">
                                            <i class="far fa-heart"></i>
                                            <h2>Your Wishlist is Empty</h2>
                                            <p>Seems like you haven't added anything to your wishlist yet. Explore our shop and find something you'll love!</p>
                                            <div class="empty-wishlist-actions">
                                                <a href="/Products/Shop" class="btn-continue-shopping">Continue Shopping</a>
                                            </div>
                                        </div>
                                    `;
                                }
                            }, 300);

                            if (typeof showNotification === 'function') {
                                showNotification('Item removed from wishlist');
                            }
                        }
                    } catch (error) {
                        console.error('Error removing item from wishlist:', error);
                        if (typeof showNotification === 'function') {
                             showNotification('Failed to remove item. Please try again.');
                        }
                    }
                });
            });
            
            // Handle add to cart
            document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    const productId = this.dataset.productId;
                    
                    try {
                        const response = await fetch(`/Cart/AddToCart?productId=${productId}&quantity=1`, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });
                        
                        const result = await response.json();
                        if (result.success) {
                            // Update cart count if exists
                            const cartCountElements = document.querySelectorAll('.cart-count');
                            if (cartCountElements.length > 0 && result.cartCount) {
                                cartCountElements.forEach(el => el.textContent = result.cartCount);
                            }

                            if (typeof showNotification === 'function') {
                                showNotification(result.message || 'Item added to cart');
                            }
                        } else {
                             if (typeof showNotification === 'function') {
                                showNotification(result.message || 'Failed to add item to cart');
                            }
                        }
                    } catch (error) {
                        console.error('Error adding item to cart:', error);
                        if (typeof showNotification === 'function') {
                            showNotification('Failed to add item to cart. Please try again.');
                        }
                    }
                });
            });
        });
    </script>
}
