@model List<Styleza.Models.Order>
@{
    ViewData["Title"] = "Order Management";
}

<div class="container admin-dashboard">
    <h1>Order Management</h1>
    <a asp-action="Index" class="admin-btn admin-btn-secondary mb-3"><i class="fas fa-arrow-left me-2"></i>Back to Dashboard</a>
    
    <div class="admin-table-container">
        <div class="admin-card-header">
            <i class="fas fa-shopping-cart me-2"></i> Orders
        </div>
        <div class="admin-card-body">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.OrderDate.ToString("MM/dd/yyyy")</td>
                                <td>@order.CustomerName</td>
                                <td>$@order.TotalAmount.ToString("F2")</td>
                                <td>
                                    <span class="admin-badge @(order.Status == "Completed" ? "admin-badge-success" : 
                                                      order.Status == "Processing" ? "admin-badge-primary" : 
                                                      order.Status == "Shipped" ? "admin-badge-info" : "admin-badge-warning")">@order.Status</span>
                                </td>
                                <td>
                                    <div class="admin-flex admin-align-center">
                                        <a asp-action="OrderDetails" asp-route-id="@order.Id" class="admin-btn admin-btn-primary admin-btn-sm me-2"><i class="fas fa-eye me-1"></i>Details</a>
                                        
                                        <div class="admin-dropdown">
                                            <button class="admin-btn admin-btn-secondary admin-btn-sm admin-dropdown-toggle">
                                                <i class="fas fa-edit me-1"></i>Status
                                            </button>
                                            <ul class="admin-dropdown-menu">
                                                <li class="admin-dropdown-form-item">
                                                    <form asp-action="UpdateOrderStatus" method="post">
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <input type="hidden" name="status" value="Processing" />
                                                        <button type="submit">Processing</button>
                                                    </form>
                                                </li>
                                                <li class="admin-dropdown-form-item">
                                                    <form asp-action="UpdateOrderStatus" method="post">
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <input type="hidden" name="status" value="Shipped" />
                                                        <button type="submit">Shipped</button>
                                                    </form>
                                                </li>
                                                <li class="admin-dropdown-form-item">
                                                    <form asp-action="UpdateOrderStatus" method="post">
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <input type="hidden" name="status" value="Completed" />
                                                        <button type="submit">Completed</button>
                                                    </form>
                                                </li>
                                                <li class="admin-dropdown-form-item">
                                                    <form asp-action="UpdateOrderStatus" method="post">
                                                        <input type="hidden" name="id" value="@order.Id" />
                                                        <input type="hidden" name="status" value="Cancelled" />
                                                        <button type="submit">Cancelled</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>