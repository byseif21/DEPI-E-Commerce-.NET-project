@using Microsoft.AspNetCore.Identity
@using Styleza.Data
@using Styleza.Models
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext DbContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Styleza - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/global.css" />
    <link rel="stylesheet" href="~/css/header.css" />
    <link rel="stylesheet" href="~/css/footer.css" />
    <link rel="stylesheet" href="~/css/mini-cart.css" />
    <link rel="stylesheet" href="~/css/notification.css" />
    <link rel="stylesheet" href="~/css/product-card.css" />
    <link rel="stylesheet" href="~/css/loader.css" />
    @if (User.IsInRole("Admin"))
    {
        <link rel="stylesheet" href="~/css/admin.css" />
    }
    @if (ViewContext.RouteData.Values["area"]?.ToString() == "Identity")
    {
        <link rel="stylesheet" href="~/css/account.css" />
    }
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/asset/img/styleza.png">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body class="@(User.Identity.IsAuthenticated ? "logged-in" : "") @(Context.Request.Path.Value.Contains("/Account/Manage") ? "manage-account-page" : "")">

    <!-- Loader -->
    @await Html.PartialAsync("_Loader")
    
    <!-- Header -->
    <header>
        <div class="container header-container">
            <div class="logo">
                Style<span>Za</span>
            </div>

            <nav class="main-navigation">
                <ul class="nav-links">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Products" asp-action="Shop" class="nav-link">Shop</a>
                        <div class="dropdown-menu mega-menu">
                            <div class="dropdown-content">
                                <div class="dropdown-column">
                                    <h3 class="dropdown-title">Women</h3>
                                    <ul class="dropdown-links">
                                        @foreach (var category in DbContext.Categories.Where(c => c.Name.Contains("Women") || c.SubCategories.Any(sc => sc.Name.Contains("Women"))).Take(5).ToList())
                                        {
                                            <li><a asp-controller="Products" asp-action="Shop" asp-route-category="@category.Name.ToLower()">@category.Name</a></li>
                                        }
                                    </ul>
                                </div>
                                <div class="dropdown-column">
                                    <h3 class="dropdown-title">Men</h3>
                                    <ul class="dropdown-links">
                                        @foreach (var category in DbContext.Categories.Where(c => c.Name.Contains("Men") || c.SubCategories.Any(sc => sc.Name.Contains("Men"))).Take(5).ToList())
                                        {
                                            <li><a asp-controller="Products" asp-action="Shop" asp-route-category="@category.Name.ToLower()">@category.Name</a></li>
                                        }
                                    </ul>
                                </div>
                                <div class="dropdown-column">
                                    <div class="featured-product">
                                        <div class="featured-product-img">
                                            <img src="/asset/img/leather Jacket.png" alt="Featured Product">
                                            <span class="featured-badge">New</span>
                                        </div>
                                        <h4 class="featured-product-title">Premium Leather Jacket</h4>
                                        <div class="featured-product-price">$299.99</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                    <li class="nav-item has-dropdown">
                        <a href="#" class="nav-link">Collections</a>
                        <div class="dropdown-menu">
                            <div class="dropdown-content">
                                <div class="dropdown-column">
                                    <h3 class="dropdown-title">Seasonal</h3>
                                    <ul class="dropdown-links">
                                        <li><a href="#">Spring/Summer 2025</a></li>
                                        <li><a href="#">Fall/Winter 2024</a></li>
                                        <li><a href="#">Resort Collection</a></li>
                                        <li><a href="#">Holiday Specials</a></li>
                                    </ul>
                                </div>
                                <div class="dropdown-column">
                                    <h3 class="dropdown-title">Designer Series</h3>
                                    <ul class="dropdown-links">
                                        <li><a href="#">Urban Minimalist</a></li>
                                        <li><a href="#">Vintage Revival</a></li>
                                        <li><a href="#">Modern Elegance</a></li>
                                        <li><a href="#">Eco-Friendly</a></li>
                                    </ul>
                                </div>
                                <div class="dropdown-column collection-showcase">
                                    <div class="collection-grid">
                                        <div class="collection-item">
                                            <img src="/asset/img/spring-fashion.jpg" alt="Collection Preview">
                                            <div class="collection-overlay">Spring</div>
                                        </div>
                                        <div class="collection-item">
                                            <img src="/asset/img/summer.jpg" alt="Collection Preview">
                                            <div class="collection-overlay">Summer</div>
                                        </div>
                                        <div class="collection-item">
                                            <img src="/asset/img/Fall.png" alt="Collection Preview">
                                            <div class="collection-overlay">Fall</div>
                                        </div>
                                        <div class="collection-item">
                                            <img src="/asset/img/winter.jpg" alt="Collection Preview">
                                            <div class="collection-overlay">Winter</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="About" class="nav-link">About</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Contact" class="nav-link">Contact</a>
                    </li>
                </ul>
            </nav>

            <div class="search-overlay">
                <div class="search-container">
                    <div class="search-header">
                        <h3>Search for products</h3>
                        <div class="search-close"><i class="fas fa-times"></i></div>
                    </div>
                    <form asp-controller="Products" asp-action="Shop" method="get" class="search-form">
                        <input type="text" name="search" placeholder="Search for products...">
                        <button type="submit"><i class="fas fa-search"></i></button>
                    </form>
                    <div class="search-popular">
                        <h4>Popular Searches:</h4>
                        <div class="popular-tags">
                            <a asp-controller="Products" asp-action="Shop" asp-route-tags="Dresses">Dresses</a>
                            <a asp-controller="Products" asp-action="Shop" asp-route-tags="Jackets">Jackets</a>
                            <a asp-controller="Products" asp-action="Shop" asp-route-tags="Shoes">Shoes</a>
                            <a asp-controller="Products" asp-action="Shop" asp-route-tags="Accessories">Accessories</a>
                            <a asp-controller="Products" asp-action="Shop" asp-route-tags="New Arrivals">New Arrivals</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nav-icons">
                <div class="nav-icon"><i class="fas fa-search" id="search-toggle"></i></div>
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="nav-icon">
                        <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"><i class="far fa-user"></i></a>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="nav-icon">
                            <a asp-controller="Admin" asp-action="Index" title="Admin Dashboard"><i class="fas fa-cog"></i></a>
                        </div>
                    }
                    <div class="nav-icon">
                        <a asp-controller="Home" asp-action="Wishlist"><i class="far fa-heart"></i></a>
                    </div>
                    <div class="nav-icon cart-icon">
                        <a href="javascript:void(0);" onclick="showMiniCart(); return false;"><i class="fas fa-shopping-bag"></i></a>
                        @{
                            var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            var cartCount = userId != null ? DbContext.CartItems.Count(c => c.UserId == userId) : 0;
                        }
                        <span class="cart-count">@cartCount</span>
                    </div>
                    <div class="nav-icon">
                        <a href="javascript:void(0);" onclick="showLogoutModal(); return false;" title="Logout"><i class="fas fa-sign-out-alt"></i></a>
                    </div>
                }
                else
                {
                    <div class="nav-icon">
                        <a href="javascript:void(0);" onclick="showLoginModal(); return false;" title="Login"><i class="far fa-user"></i></a>
                    </div>
                    <div class="nav-icon">
                        <a asp-controller="Home" asp-action="Wishlist"><i class="far fa-heart"></i></a>
                    </div>
                    <div class="nav-icon cart-icon">
                        <a href="javascript:void(0);" onclick="showMiniCart(); return false;"><i class="fas fa-shopping-bag"></i></a>
                        <span class="cart-count">0</span>
                    </div>
                    @* <div class="nav-icon">
                        <a asp-controller="Account" asp-action="Register">Register</a>
                    </div> *@
                }
            </div>

            <div class="hamburger">
                <i class="fas fa-bars"></i>
            </div>
        </div>

        <div class="mobile-menu">
            <div class="mobile-menu-header">
                <div class="logo">Style<span>Za</span></div>
                <div class="mobile-close"><i class="fas fa-times"></i></div>
            </div>
            <ul class="mobile-nav-links">
                <li class="mobile-nav-item">
                    <a asp-controller="Home" asp-action="Index" class="mobile-nav-link">Home</a>
                </li>
                <li class="mobile-nav-item has-submenu">
                    <div class="mobile-nav-toggle">
                        <a asp-controller="Products" asp-action="Shop" class="mobile-nav-link">Shop</a>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <ul class="mobile-submenu">
                        <li><h3>Women</h3></li>
                        @foreach (var category in DbContext.Categories.Where(c => c.Name.Contains("Women") || c.SubCategories.Any(sc => sc.Name.Contains("Women"))).Take(5).ToList())
                        {
                            <li><a asp-controller="Products" asp-action="Shop" asp-route-category="@category.Name.ToLower()">@category.Name</a></li>
                        }
                        <li><h3>Men</h3></li>
                        @foreach (var category in DbContext.Categories.Where(c => c.Name.Contains("Men") || c.SubCategories.Any(sc => sc.Name.Contains("Men"))).Take(5).ToList())
                        {
                            <li><a asp-controller="Products" asp-action="Shop" asp-route-category="@category.Name.ToLower()">@category.Name</a></li>
                        }
                    </ul>
                </li>
                <li class="mobile-nav-item has-submenu">
                    <div class="mobile-nav-toggle">
                        <a href="#" class="mobile-nav-link">Collections</a>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <ul class="mobile-submenu">
                        <li><h3>Seasonal</h3></li>
                        <li><a href="#">Spring/Summer 2025</a></li>
                        <li><a href="#">Fall/Winter 2024</a></li>
                        <li><a href="#">Resort Collection</a></li>
                        <li><a href="#">Holiday Specials</a></li>
                        <li><h3>Designer Series</h3></li>
                        <li><a href="#">Urban Minimalist</a></li>
                        <li><a href="#">Vintage Revival</a></li>
                        <li><a href="#">Modern Elegance</a></li>
                        <li><a href="#">Eco-Friendly</a></li>
                    </ul>
                </li>
                <li class="mobile-nav-item">
                    <a asp-controller="Home" asp-action="About" class="mobile-nav-link">About</a>
                </li>
                <li class="mobile-nav-item">
                    <a asp-controller="Home" asp-action="Contact" class="mobile-nav-link">Contact</a>
                </li>
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="mobile-nav-item">
                        <a asp-area="Identity" asp-page="/Account/Manage/Index" class="mobile-nav-link"><i class="far fa-user me-2"></i>My Account</a>
                    </li>
                    <li class="mobile-nav-item">
                        <a asp-controller="Home" asp-action="Wishlist" class="mobile-nav-link"><i class="far fa-heart me-2"></i>Wishlist</a>
                    </li>
                    <li class="mobile-nav-item">
                        <a href="javascript:void(0);" onclick="showLogoutModal(); return false;" class="mobile-nav-link"><i class="fas fa-sign-out-alt me-2"></i>Logout</a>
                    </li>
                }
                else
                {
                    <li class="mobile-nav-item">
                        <a href="javascript:void(0);" onclick="showLoginModal(); return false;" class="mobile-nav-link">Login</a>
                    </li>
                    <li class="mobile-nav-item">
                        <a asp-controller="Account" asp-action="Register" class="mobile-nav-link">Register</a>
                    </li>
                }
            </ul>
            <div class="mobile-nav-footer">
                <div class="mobile-nav-footer-icons">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-pinterest-p"></i></a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    @if (ViewContext.RouteData.Values["area"]?.ToString() == "Identity" && (ViewContext.RouteData.Values["page"]?.ToString().Contains("/Manage/") == true || ViewContext.RouteData.Values["page"]?.ToString().EndsWith("/Manage") == true))
    {
        <div class="manage-account-container">
            <div class="container manage-content">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }


    <!-- Footer -->
    <partial name="_Footer" />

    <!-- Scripts -->
    <script src="~/js/loader.js"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
    <script src="~/js/cart.js"></script>
    <script src="~/js/wishlist.js" asp-append-version="true"></script>
    <script src="~/js/error-handler.js"></script>

    @RenderSection("Scripts", required: false)

    <!-- Login Modal -->
    <div id="login-modal" class="auth-modal-overlay">
        <div class="auth-modal-container">
            <div class="auth-modal-close" onclick="closeLoginModal()"><i class="fas fa-times"></i></div>
            <div class="account-form-container">
                <h2>Welcome Back</h2>
                <p class="subtitle">Please enter your details to sign in</p>
                
                <form id="modal-login-form" method="post" asp-controller="Account" asp-action="Login">
                    <div class="form-group">
                        <label>Email Address</label>
                        <input name="Email" type="email" class="form-control" placeholder="name@example.com" required />
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input name="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <div class="form-group">
                        <label class="checkbox-container">
                            <input name="RememberMe" type="checkbox" value="true" />
                            <span class="checkmark"></span>
                            <span>Remember Me</span>
                        </label>
                    </div>
                    <button type="submit" class="btn-login">Sign In</button>
                    <div class="form-footer">
                        <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
                        <p style="color: rgba(255,255,255,0.5); font-size: 14px; margin-top: 15px;">
                            Don't have an account? <a href="@Url.Action("Register", "Account")" style="color: var(--secondary); margin: 0; font-weight: 600;">Register now</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Logout Confirmation Modal -->
    <div id="logout-modal" class="auth-modal-overlay">
        <div class="auth-modal-container confirmation-modal">
            <div class="auth-modal-close" onclick="closeLogoutModal()"><i class="fas fa-times"></i></div>
            <div class="account-form-container">
                <h2>Ready to leave?</h2>
                <p class="subtitle">Are you sure you want to log out of your account?</p>
                <div class="modal-actions">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn-login">Yes, Logout</button>
                    </form>
                    <button class="btn-login cancel-btn" onclick="closeLogoutModal()" style="background: rgba(255,255,255,0.1); margin-top: 15px;">Cancel</button>
                </div>
            </div>
        </div>
    </div>



</body>
</html>