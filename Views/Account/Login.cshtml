@model Styleza.Models.LoginModel
@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" />
}

<div class="account-page">
    <div class="account-form-container">
        <h2>Welcome Back</h2>
        <p class="subtitle">Please enter your details to sign in</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <form id="account" method="post" asp-controller="Account" asp-action="Login">
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="checkbox-container">
                    <input asp-for="RememberMe" />
                    <span class="checkmark"></span>
                    <span>@Html.DisplayNameFor(m => m.RememberMe)</span>
                </label>
            </div>

            <button id="login-submit" type="submit" class="btn-login">
                <span>Sign In</span>
            </button>

            <div class="form-footer">
                <p>
                    <a id="forgot-password" asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                </p>
                <p style="color: rgba(255,255,255,0.5); font-size: 14px; margin-top: 15px;">
                    Don't have an account? <a asp-controller="Account" asp-action="Register" style="color: var(--secondary); margin: 0; font-weight: 600;">Register now</a>
                </p>
            </div>
        </form>
    </div>
</div>