@{
    ViewData["Title"] = "Account Locked";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" />
}

<div class="account-page">
    <div class="account-form-container">
        <h2>Account Locked</h2>
        <div class="alert alert-danger" style="background: rgba(255, 65, 108, 0.1); border: 1px solid rgba(255, 65, 108, 0.2); color: #ff4b2b;">
            <p>
                This account has been locked out due to too many failed login attempts. 
                Please try again later or contact support.
            </p>
        </div>
        
        <div class="form-footer" style="border:none; padding-top:10px;">
            <a asp-controller="Home" asp-action="Index" class="btn-login" style="display:block; text-align:center;">
                <span>Return Home</span>
            </a>
        </div>
    </div>
</div>