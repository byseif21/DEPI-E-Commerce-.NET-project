@{
    ViewData["Title"] = "Email Confirmed";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" />
}

<div class="account-page">
    <div class="account-form-container">
        <h2>Email Confirmed</h2>
        <p class="subtitle">Thank you for confirming your email. Your account is now active.</p>
        
        <div class="form-footer" style="border:none; padding:0;">
            <a asp-controller="Home" asp-action="Index" class="btn-login" style="display:block; text-align:center;">
                <span>Continue Shopping</span>
            </a>
        </div>
    </div>
</div>