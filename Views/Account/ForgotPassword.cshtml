@model Styleza.Models.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" />
}

<div class="account-page">
    <div class="account-form-container">
        <h2>Forgot Password?</h2>
        <p class="subtitle">Enter your email and we'll send you a reset link.</p>

        <form id="forgot-password-form" method="post" asp-controller="Account" asp-action="ForgotPassword">
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button id="forgot-password-submit" type="submit" class="btn-login">
                <span>Send Reset Link</span>
            </button>

            <div class="form-footer">
                <p>
                    <a asp-controller="Account" asp-action="Login">Return to login</a>
                </p>
            </div>
        </form>
    </div>
</div>